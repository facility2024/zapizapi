WAPI_INSTANCE_ID=
WAPI_TOKEN=
WAPI_BASE_URL=https://api.w-api.app
PORT=3001
# Banco local (SQLite) — funciona em qualquer host com disco persistente
# No Easypanel, monte um volume no caminho do banco para não perder os dados.
DATABASE_URL="file:./dev.db"

# SMTP Hostinger — caixa principal suporte@coconudi.com
# Host/porta fixos da Hostinger; senha NUNCA aqui, só no .env real
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=suporte@coconudi.com
SMTP_PASSWORD=
NOTIFY_TO=suporte@coconudi.com
